# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Optional external Google Maps Platform API key.
# When provided, enables production Google Maps satellite/vector layers alongside RallyOn venue markers.
# By default, RallyOn uses its high-performance built-in interactive Austin intelligence canvas.
VITE_GOOGLE_MAPS_API_KEY=""

# VITE_GOOGLE_PLACES_API_KEY: Optional external Google Places API key for venue identity discovery & place matching.
VITE_GOOGLE_PLACES_API_KEY=""

# SPORTS_DATA_API_KEY: Optional external live sports data provider key (e.g. Sportradar, TheSportsDB, or ESPN private gateway).
# When provided, enables production live score/clock feeds. RallyOn includes a modular provider adapter with seed data.
SPORTS_DATA_API_KEY=""

# VITE_ESPN_API_BASE_URL: Optional ESPN public/private API endpoint base URL.
VITE_ESPN_API_BASE_URL="https://site.api.espn.com/apis/site/v2/sports"

# VITE_STRIPE_PUBLIC_KEY: Future monetization infrastructure publishable key for venue claiming subscriptions and sponsored game promotions.
VITE_STRIPE_PUBLIC_KEY=""

# AUTHENTICATION CONFIGURATION
# VITE_GOOGLE_CLIENT_ID: OAuth 2.0 Web Client ID from Google Cloud Console / Google Identity Services.
# When provided, enables production 1-tap and popup Google Sign-In for RallyOn.
VITE_GOOGLE_CLIENT_ID=""

# VITE_APPLE_CLIENT_ID: Service ID for Sign in with Apple from Apple Developer Console.
# When provided, enables Apple Sign-In authentication.
VITE_APPLE_CLIENT_ID=""

# VITE_AUTH_API_ENDPOINT: Optional backend authentication proxy endpoint for token verification, email dispatch, and sessions.
VITE_AUTH_API_ENDPOINT=""

